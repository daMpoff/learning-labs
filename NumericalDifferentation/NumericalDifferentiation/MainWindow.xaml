<Window x:Class="NumericalDifferentiation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Численное дифференцирование" Height="500" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель управления -->
        <StackPanel Grid.Column="0" Margin="16">
            <TextBlock Text="Режим:"/>
            <ComboBox x:Name="InputModeComboBox" Margin="0,2,0,14" SelectionChanged="InputModeComboBox_SelectionChanged">
                <ComboBoxItem Content="Функция" IsSelected="True"/>
                <ComboBoxItem Content="Точки"/>
            </ComboBox>

            <!-- Панель для режима Функция -->
            <StackPanel x:Name="FunctionPanel">
                <TextBlock Text="Формула функции:"/>
                <TextBox x:Name="FormulaBox" Text="sin(x)" Margin="0,2,0,10"/>
                <TextBlock Text="Начало интервала (x0):"/>
                <TextBox x:Name="StartXBox" Text="-5" Margin="0,2,0,10"/>
                <TextBlock Text="Конец интервала:"/>
                <TextBox x:Name="EndXBox" Text="5" Margin="0,2,0,10"/>
                <TextBlock Text="Шаг:"/>
                <TextBox x:Name="StepBox" Text="0.1" Margin="0,2,0,12"/>
            </StackPanel>

            <!-- Панель для режима Точки -->
            <StackPanel x:Name="PointsPanel" Visibility="Collapsed">
                <TextBlock Text="Добавьте точку:"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                    <TextBlock Text="x:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="XInputBox" Width="60"/>
                    <TextBlock Text="y:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBox x:Name="YInputBox" Width="60"/>
                    <Button x:Name="AddPointButton" Content="Добавить" Width="80" Height="26" Margin="10,0,0,0" Click="AddPointButton_Click"/>
                </StackPanel>
                <TextBlock Text="Список точек:" Margin="0,0,0,2"/>
                <ListBox x:Name="PointsListBox" Height="80" Margin="0,0,0,4"/>
                <Button x:Name="RemovePointButton" Content="Удалить выбранную точку" Height="26" Click="RemovePointButton_Click"/>
                <!-- Дифференцирование по точкам -->
                <TextBlock Text="Метод для точек:" Margin="0,8,0,2"/>
                <ComboBox x:Name="PointsDiffMethodComboBox" Height="26" Margin="0,0,0,6"/>
                <TextBlock Text="Число ближайших точек:" Margin="0,8,0,2"/>
                <TextBox x:Name="PointsCountBox" Width="60" Text="3" Margin="0,0,0,8"/>
            </StackPanel>

            <Button x:Name="AddPointsButton" Content="Построить" Height="34" Margin="0,12,0,0"
                    Background="#4a90e2" Foreground="White" FontWeight="Bold" Click="AddPoints_Click"/>

            <TextBlock Text="Точка для производной:" Margin="0,14,0,0"/>
            <TextBox x:Name="DiffXInputBox" Height="28" Margin="0,2,0,10"/>

            <!-- Панель метода разности: показывается только в режиме "Функция" -->
            <StackPanel x:Name="DiffMethodPanel">
                <TextBlock Text="Метод разности:" Margin="0,10,0,0"/>
                <ComboBox x:Name="DifferenceMethodComboBox" Margin="0,2,0,10" SelectedIndex="0" SelectionChanged="DifferenceMethodComboBox_SelectionChanged">
                    <ComboBoxItem Content="Левая разность"/>
                    <ComboBoxItem Content="Правая разность"/>
                    <ComboBoxItem Content="Центральная разность"/>
                    <ComboBoxItem Content="Любого порядка"/>
                </ComboBox>
                <StackPanel x:Name="OrderPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,2,0,10">
                    <TextBlock Text="Порядок:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="OrderInputBox" Width="40" Text="2"/>
                </StackPanel>
            </StackPanel>

            <Button x:Name="DiffButton" Content="Вычислить производную" Height="34"
                    Background="#E2854A" Foreground="White" FontWeight="Bold" Click="DiffButton_Click"/>
            <TextBlock x:Name="DiffResultTextBlock" Margin="0,7,0,0" FontWeight="Bold"/>
        </StackPanel>

        <!-- Правая часть: график -->
        <scottplot:WpfPlot x:Name="Plot" Grid.Column="1" Margin="12"/>
    </Grid>
</Window>
