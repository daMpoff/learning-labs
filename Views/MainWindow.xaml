<Window x:Class="SLAE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SLAE"
        xmlns:vm="clr-namespace:SLAE.ViewModels" 
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:wm="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        mc:Ignorable="d"
        Title="Решение систем алгебраических линейных уравнений"
        Style="{StaticResource MaterialDesignWindow}"
        Height="600"
        Width="1200">
    <Window.DataContext>
        <vm:ViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="7*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource DarkBackgroundColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Padding="20,0" Text="Количество уравнений:" FontFamily="{StaticResource vkFont}" Foreground="White" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center"></TextBlock>
            <ComboBox 
                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                ItemsSource="{Binding Numbers}"
                SelectedItem="{Binding EquationsCount}"
                FontSize="20"
                Background="White"
                Grid.Column="1"
                Padding="10,0">
            </ComboBox>
            <TextBlock Grid.Column="2" Padding="20,0" Text="Количество Неизвестных:" FontFamily="{StaticResource vkFont}" Foreground="White" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center"></TextBlock>
            <ComboBox 
                ItemsSource="{Binding Numbers}"
                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                SelectedItem="{Binding VariablesCount}"
                FontSize="20"
                Background="White"
                Grid.Column="3"
                Padding="10,0">
            </ComboBox>
            <Button Grid.Column="4" Margin="10,0,0,0" FontSize="20" Width="150" Background="Green">Решить</Button>
        </Grid>
        <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Equations}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding CoefficientVariablePairs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                    <!-- Здесь задаем горизонтальную ориентацию -->
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Обязательно задаем горизонтальную ориентацию для каждого элемента -->
                                        <TextBox Width="40" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0" Text="{Binding Coefficient.Value, Mode=TwoWay}"/>
                                        <wm:FormulaControl Formula="{Binding Variable}" FontSize="24" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text=" = " FontSize="24" VerticalAlignment="Center"/>
                        <TextBox Width="60" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0" Text="{Binding Result, Mode=TwoWay}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>