<Window x:Class="SLAE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SLAE"
        xmlns:vm="clr-namespace:SLAE.ViewModels"
        mc:Ignorable="d"
        Title="Решение систем алгебраических линейных уравнений"
        Style="{StaticResource MaterialDesignWindow}" 
        Height="600" 
        Width="1200">
    <Window.DataContext>
        <vm:ViewModel></vm:ViewModel>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="7*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Background="{StaticResource DarkBackgroundColor}"></StackPanel>
    </Grid>
</Window>
