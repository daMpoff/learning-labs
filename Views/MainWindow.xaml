<Window x:Class="SLAE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SLAE"
        xmlns:vm="clr-namespace:SLAE.ViewModels" 
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:wm="clr-namespace:WpfMath.Controls;assembly=WpfMath" 
        xmlns:converters="clr-namespace:SLAE.Converters"
        mc:Ignorable="d"
        Title="Решение систем алгебраических линейных уравнений"
        Style="{StaticResource MaterialDesignWindow}"
        Height="650"
        Width="1400">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:ViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="7*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource DarkBackgroundColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Padding="20,0" Text="Количество уравнений:" FontFamily="{StaticResource vkFont}" Foreground="White" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center"></TextBlock>
            <ComboBox 
                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                ItemsSource="{Binding Numbers}"
                SelectedItem="{Binding EquationsCount}"
                FontSize="16"
                Background="White"
                Grid.Column="1"
                Padding="15,0">
            </ComboBox>
            <TextBlock Grid.Column="2" Padding="20,0" Text="Количество переменных:" FontFamily="{StaticResource vkFont}" Foreground="White" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center"></TextBlock>
            <ComboBox 
                ItemsSource="{Binding Numbers}"
                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                SelectedItem="{Binding VariablesCount}"
                FontSize="16"
                Background="White"
                Grid.Column="3"
                Padding="10,0">
            </ComboBox>
            <Button Grid.Column="4" Margin="10,0,0,0" FontSize="20" Width="150" Background="Green" Command="{Binding GetResultCommand}">Решить</Button>
        </Grid>
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="Black" BorderThickness="0,0,3,0">
            <ItemsControl ItemsSource="{Binding Equations}" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding CoefficientVariablePairs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Padding="0" Style="{StaticResource MaterialDesignOutlinedTextBox}" BorderBrush="LightGray" Width="40" Height="40" FontSize="20" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding Coefficient.Value, Mode=TwoWay}"/>
                                            <wm:FormulaControl Formula="{Binding Variable}" Margin="3,5,0,0" VerticalAlignment="Center"/>
                                            <!-- Знак + отображается только если это не последний элемент -->
                                            <TextBlock Text=" + " FontSize="20" Margin="0,0,0,5" VerticalAlignment="Center" Visibility="{Binding IsLast, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text=" = " FontSize="20" VerticalAlignment="Center"/>
                            <TextBox BorderBrush="LightGray" Style="{StaticResource MaterialDesignOutlinedTextBox}" Width="40" Height="40" Padding="0" FontSize="20" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding Result, Mode=TwoWay}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <!-- Новый StackPanel для CheckBox -->
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- CheckBox элементы -->
                <CheckBox Content="{Binding Methods[0].Name}" Margin="10" Grid.Row="0" Grid.Column="0"
                  IsChecked="{Binding Methods[0].IsEnable, Mode=TwoWay}" />
                <CheckBox Content="{Binding Methods[1].Name}" Margin="10" Grid.Row="0" Grid.Column="1"
                  IsChecked="{Binding Methods[1].IsEnable, Mode=TwoWay}" />
                <CheckBox Content="{Binding Methods[2].Name}" Margin="10" Grid.Row="1" Grid.Column="0"
                  IsChecked="{Binding Methods[2].IsEnable, Mode=TwoWay}" />
                <CheckBox Content="Метод Гаусса-Жордано" Margin="10" Grid.Row="1" Grid.Column="1"
                  IsChecked="{Binding Methods[3].IsEnable, Mode=TwoWay}" />
                <CheckBox Content="Метод прогонки" Margin="10" Grid.Row="2" Grid.Column="0"
                  IsChecked="{Binding Methods[4].IsEnable, Mode=TwoWay}" />
                <CheckBox Content="Метод LU-разложения" Margin="10" Grid.Row="2" Grid.Column="1"
                  IsChecked="{Binding Methods[5].IsEnable, Mode=TwoWay}" />
                <CheckBox Content="Метод квадратных корней" Margin="10" Grid.Row="3" Grid.Column="0"
                  IsChecked="{Binding Methods[6].IsEnable, Mode=TwoWay}" />
                <CheckBox Content="Метод простых итераций" Margin="10" Grid.Row="3" Grid.Column="1"
                  IsChecked="{Binding Methods[7].IsEnable, Mode=TwoWay}" />
                <CheckBox Content="Метод Зейделя" Margin="10" Grid.Row="4" Grid.Column="0"
                  IsChecked="{Binding Methods[8].IsEnable, Mode=TwoWay}" />
                <!-- CheckBox для выбора/снятия всех -->
                <CheckBox Content="Выбрать всё" Grid.Row="4" Grid.Column="1" Margin="10"
                          IsChecked="{Binding IsAllSelected, Mode=TwoWay}" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
