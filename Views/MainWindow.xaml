<Window x:Class="SLAE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SLAE"
        xmlns:vm="clr-namespace:SLAE.ViewModels" 
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:wm="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        mc:Ignorable="d"
        Title="Решение систем алгебраических линейных уравнений"
        Style="{StaticResource MaterialDesignWindow}"
        Height="600"
        Width="1200">
    <Window.DataContext>
        <vm:ViewModel></vm:ViewModel>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="7*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource DarkBackgroundColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Padding="20,0" Text="Количество уравнений:" FontFamily="{StaticResource vkFont}" Foreground="White" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center"></TextBlock>
            <ComboBox 
                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                ItemsSource="{Binding Numbers}"
                SelectedItem="{Binding EquationsCount}"
                FontSize="20"
                Background="White"
                Grid.Column="1"
                Padding="10,0">
            </ComboBox>
            <TextBlock Grid.Column="2" Padding="20,0" Text="Количество Неизвестных:" FontFamily="{StaticResource vkFont}" Foreground="White" FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center"></TextBlock>
            <ComboBox 
                ItemsSource="{Binding Numbers}"
                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                SelectedItem="{Binding VariablesCount}"
                FontSize="20"
                Background="White"
                Grid.Column="3"
                Padding="10,0">
            </ComboBox>
            <Button Grid.Column="4" Margin="10,0,0,0" FontSize="20" Width="150" Background="Green">Решить</Button>
        </Grid>
        <Grid
            Grid.Row="1"
            Grid.ColumnSpan="2">
            <Grid Margin="10" HorizontalAlignment="Left">
                <!-- Определение строк и столбцов -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Уравнение 1 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Коэффициент перед x1 -->
                    <TextBox Width="40" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                    <wm:FormulaControl Formula="x_1" FontSize="24" VerticalAlignment="Center"/>

                    <!-- "+" между переменными -->
                    <TextBlock Text=" + " FontSize="24" VerticalAlignment="Center"/>

                    <!-- Коэффициент перед x2 -->
                    <TextBox Width="40" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                    <wm:FormulaControl Formula="x_2" FontSize="24" VerticalAlignment="Center"/>

                    <!-- "+" между переменными -->
                    <TextBlock Text=" + " FontSize="24" VerticalAlignment="Center"/>

                    <!-- Коэффициент перед x3 -->
                    <TextBox Width="40" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                    <wm:FormulaControl Formula="x_3" FontSize="24" VerticalAlignment="Center"/>

                    <!-- "=" и поле для ввода результата -->
                    <TextBlock Text=" = " FontSize="24" VerticalAlignment="Center"/>
                    <TextBox Width="60" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                </StackPanel>
                <!-- Уравнение 2 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Width="40" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                    <wm:FormulaControl Formula="x_1" FontSize="24" VerticalAlignment="Center"/>

                    <TextBlock Text=" + " FontSize="24" VerticalAlignment="Center"/>
                    <TextBox Width="40" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                    <wm:FormulaControl Formula="x_2" FontSize="24" VerticalAlignment="Center"/>

                    <TextBlock Text=" + " FontSize="24" VerticalAlignment="Center"/>
                    <TextBox Width="40" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                    <wm:FormulaControl Formula="x_3" FontSize="24" VerticalAlignment="Center"/>

                    <TextBlock Text=" = " FontSize="24" VerticalAlignment="Center"/>
                    <TextBox Width="60" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                </StackPanel>
                <!-- Уравнение 3 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Width="40" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                    <wm:FormulaControl Formula="x_1" FontSize="24" VerticalAlignment="Center"/>

                    <TextBlock Text=" + " FontSize="24" VerticalAlignment="Center"/>
                    <TextBox Width="40" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                    <wm:FormulaControl Formula="x_2" FontSize="24" VerticalAlignment="Center"/>

                    <TextBlock Text=" + " FontSize="24" VerticalAlignment="Center"/>
                    <TextBox Width="40" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                    <wm:FormulaControl Formula="x_3" FontSize="24" VerticalAlignment="Center"/>

                    <TextBlock Text=" = " FontSize="24" VerticalAlignment="Center"/>
                    <TextBox Width="60" FontSize="24" VerticalAlignment="Center" TextAlignment="Center" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
