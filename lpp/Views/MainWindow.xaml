<Window x:Class="lpp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:lpp.Views"
        Title="LPP · Линейное программирование" Width="1360" Height="900"
        MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="#ECF2F6" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13" Language="ru-RU"
        UseLayoutRounding="True">
    <Grid Background="#ECF2F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="108" />
            <RowDefinition />
            <RowDefinition Height="33" />
        </Grid.RowDefinitions>

        <Border Background="#142838">
            <Grid Margin="32,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="53" Height="53" CornerRadius="12" Background="#204354" Margin="0,0,17,0">
                        <Path Width="29" Height="29" Stretch="Uniform" Stroke="#6DE1C2" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 2,2 L 2,25 L 25,25 M 6,21 L 13,10 L 19,15 L 25,4 M 19,4 L 25,4 L 25,10" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="LPP   /   ГРАФИЧЕСКИЙ МЕТОД" Foreground="#82DEC9"
                                   FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Линейное программирование" Foreground="#F4F9FC"
                                   FontSize="33" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="17,10"
                        CornerRadius="9" BorderBrush="#486477" BorderThickness="1">
                    <TextBlock Text="ДВЕ ПЕРЕМЕННЫЕ     x₁, x₂" Foreground="#D3E3EB"
                               FontSize="12" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="32,20,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="328" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="14" />
                <RowDefinition Height="100" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="01   /   ВВОД ДАННЫХ" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="1" Text="Условия задачи" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,15" />

                    <TextBlock Grid.Row="2" Text="ЦЕЛЕВАЯ ФУНКЦИЯ  F(x)" Style="{StaticResource Label}" Margin="0,0,0,7" />
                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ObjectiveXBox" Text="{Binding ObjectiveX, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Коэффициент x₁ в целевой функции" />
                        <TextBlock Grid.Column="1" Text="x₁ +" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBox x:Name="ObjectiveYBox" Grid.Column="2" Text="{Binding ObjectiveY, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Коэффициент x₂ в целевой функции" />
                        <TextBlock Grid.Column="3" Text="x₂ →" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <ComboBox x:Name="GoalBox" Grid.Column="4" SelectedIndex="{Binding GoalIndex}" AutomationProperties.Name="Направление оптимизации">
                            <ComboBoxItem Content="max" />
                            <ComboBoxItem Content="min" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="ЛИНЕЙНЫЕ ОГРАНИЧЕНИЯ" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <Grid Grid.Row="5" Margin="0,0,5,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="55" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="x₁" Style="{StaticResource Label}" Margin="7,0,0,0" />
                        <TextBlock Text="x₂" Grid.Column="1" Style="{StaticResource Label}" Margin="7,0,0,0" />
                        <TextBlock Text="знак" Grid.Column="2" Style="{StaticResource Label}" Margin="7,0,0,0" />
                        <TextBlock Text="b" Grid.Column="3" Style="{StaticResource Label}" Margin="7,0,0,0"
                                   ToolTip="Правая часть ограничения" />
                    </Grid>
                    <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="ConstraintRows" ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,5,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="55" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding A, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0"
                                                 AutomationProperties.Name="Коэффициент x₁" />
                                        <TextBox Grid.Column="1" Text="{Binding B, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0"
                                                 AutomationProperties.Name="Коэффициент x₂" />
                                        <ComboBox Grid.Column="2" SelectedIndex="{Binding RelationIndex}" Margin="0,0,5,0"
                                                  AutomationProperties.Name="Знак ограничения">
                                            <ComboBoxItem Content="≤" />
                                            <ComboBoxItem Content="≥" />
                                            <ComboBoxItem Content="=" />
                                        </ComboBox>
                                        <TextBox Grid.Column="3" Text="{Binding C, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0"
                                                 AutomationProperties.Name="Правая часть ограничения" />
                                        <Button Grid.Column="4" Content="×" Padding="0" FontSize="15"
                                                AutomationProperties.Name="Удалить ограничение" Click="Remove_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="7" Margin="0,8,0,10">
                        <Button x:Name="AddButton" Content="+  Ограничение" HorizontalAlignment="Left" Click="Add_Click" />
                        <TextBlock Text="По умолчанию  x₁ ≥ 0  и  x₂ ≥ 0" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="8" Text="{Binding Error}" TextWrapping="Wrap" Foreground="#A12936">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Error}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.Row="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition Width="87" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SolveButton" Content="Решить  →" IsDefault="True" MinHeight="39"
                                Background="{StaticResource Teal}" Foreground="White" BorderBrush="{StaticResource Teal}" Click="Solve_Click" />
                        <Button Grid.Column="2" Content="Пример" Click="Example_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,15,18,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="1,0,1,8">
                        <StackPanel>
                            <TextBlock Text="02   /   ВИЗУАЛИЗАЦИЯ" Style="{StaticResource Label}" />
                            <TextBlock Text="Допустимая область" FontSize="23" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Content="Вписать график" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="Fit_Click" />
                    </Grid>
                    <views:PlotView x:Name="Plot" Grid.Row="1" Data="{Binding Data}"
                                    AutomationProperties.Name="График допустимой области" />
                    <DockPanel Grid.Row="2" Margin="5,6,5,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,1,0,0"
                                    VerticalAlignment="Top" Visibility="{Binding LevelLegendVisibility}">
                            <Line X1="0" X2="15" Y1="2" Y2="2" Stroke="{StaticResource Teal}"
                                  StrokeThickness="2" StrokeDashArray="2,1" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Уровень F*" Foreground="{StaticResource Teal}" FontSize="12" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="62" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Boundaries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,17,2">
                                            <Rectangle Width="13" Height="3" RadiusX="1" RadiusY="1" Fill="{Binding Color}"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource Muted}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="17,11" Background="#DDF2EB" BorderBrush="#B4DDD0"
                    BorderThickness="1" CornerRadius="13">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource Label}" Foreground="#086859" />
                    <TextBlock x:Name="ResultValueText" Text="{Binding ResultValue}" FontSize="22" FontWeight="SemiBold"
                               Margin="0,3,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ResultPoint}" Foreground="#276052" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="16,10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="03   /   ВЕРШИНЫ" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <Border Background="#EBF2F6" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding VertexCount}" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Координаты и значение F в каждой вершине" Foreground="{StaticResource Muted}"
                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Vertices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,6,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F6F9FB" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOptimal}" Value="True">
                                                        <Setter Property="Background" Value="#DFF3EC" />
                                                        <Setter Property="BorderBrush" Value="#90CFBB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Coordinates}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Value, StringFormat='F = {0}'}"
                                                       Foreground="{StaticResource Teal}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="33,0">
            <TextBlock Text="LPP   /   РЕШАТЕЛЬ ДВУМЕРНЫХ ЗАДАЧ" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <TextBlock Text="Колесо · масштаб     Перетаскивание · сдвиг" Style="{StaticResource Label}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
