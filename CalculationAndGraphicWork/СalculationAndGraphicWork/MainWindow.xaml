<Window x:Class="СalculationAndGraphicWork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottplot="http://schemas.scottplot.net/2008/xaml/presentation"
        Title="Интерполяция и анализ" Height="600" Width="950">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">

            <!-- Формула -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="F(x) =" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="FormulaBox" Text="2*x+(x^2)" Grid.Column="1" Margin="4,0,0,0"/>
            </Grid>

            <!-- Start X -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Start X:" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="StartXBox" Text="-3" Grid.Column="1" Margin="4,0,0,0"/>
            </Grid>

            <!-- End X -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="End X:" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="EndXBox" Text="3" Grid.Column="1" Margin="4,0,0,0"/>
            </Grid>

            <!-- Шаг функции -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Шаг функции:" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="StepBox" Text="1" Grid.Column="1" Margin="4,0,0,0"/>
            </Grid>
            
            <!-- Шаг интерполяции -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Шаг интерполяции:" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="InterpStepBox" Text="0.01" Grid.Column="1" Margin="4,0,0,0"/>
            </Grid>

            <!-- Кнопки -->
            <Button Content="Построить точки" Click="AddPoints_Click" Margin="0,6,0,0"/>
            <Button Content="Построить интерполяции" Click="Interpolate_Click" Margin="0,8,0,0"/>
            <Button Content="Очистить график" Click="ClearPlot_Click" Margin="0,20,0,0" />
            <Button Content="Сравнить методы" Click="Analyze_Click" Margin="0,20,0,0"/>
        </StackPanel>

        <!-- Правая часть: график и таблица -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <scottplot:WpfPlot x:Name="Plot" Grid.Row="0"/>
            <DataGrid x:Name="ResultsDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      Margin="0,20,0,0"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Метод" Binding="{Binding Method}" />
                    <DataGridTextColumn Header="MSE" Binding="{Binding MSE, StringFormat=F6}" />
                    <DataGridTextColumn Header="MAE" Binding="{Binding MAE, StringFormat=F6}" />
                    <DataGridTextColumn Header="Максимальная ошибка" Binding="{Binding MaxError, StringFormat=F6}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
